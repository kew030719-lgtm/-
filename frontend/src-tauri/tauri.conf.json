{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CareerRadar",
  "version": "0.1.0",
  "identifier": "com.careerradar.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../desktop"
  },
  "app": {
    "windows": [{
      "title": "CareerRadar",
      "width": 1280,
      "height": 820
    }],
    "security": {"csp": "default-src 'self'; connect-src http://127.0.0.1:8000; script-src 'self'; style-src 'self' 'unsafe-inline'"}
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "externalBin": ["binaries/career-radar-sidecar"],
    "resources": ["../../browser-extension/*"],
    "windows": {"webviewInstallMode": {"type": "downloadBootstrapper", "silent": true}}
  }
}
